# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERVEUR & SECURITE
PORT=3000
NODE_ENV="production"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# CONFIGURATION SMTP NODEMAILER
# Exemple avec OVH, Brevo, Gmail ou hébergeur dédié
SMTP_HOST="smtp.fatous-cleaner.net"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="info@fatous-cleaner.net"
SMTP_PASS="votre_mot_de_passe_application_securise"
SMTP_FROM="\"Fatou's Clean\" <info@fatous-cleaner.net>"

# EMAIL DE L'ADMINISTRATEUR (pour recevoir les alertes de réservation)
ADMIN_EMAIL="info@fatous-cleaner.net"

# NOTIFICATIONS WHATSAPP (GUINÉE +224 623 07 82 50)
TWILIO_ACCOUNT_SID="AC_VOTRE_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="VOTRE_TWILIO_AUTH_TOKEN"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
ADMIN_WHATSAPP_TO="whatsapp:+224623078250"

